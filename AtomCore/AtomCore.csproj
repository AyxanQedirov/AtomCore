<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<PackageId>AtomCore</PackageId>
		<Version>3.10.2</Version>
		<Authors>Aykhan Gadirov</Authors>
		<Company>Aykhan Gadirov</Company>
		<Product>AtomCore</Product>
		<Description>This package contains core and shareable functionalities for .NET applications 🌍</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>core, api, common, shared, exception, handling</PackageTags>
		<RepositoryUrl>https://github.com/AyxanQedirov/Core</RepositoryUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReleaseNotes>- Changed json key naming convention</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="ExceptionHandling\GrpcHandler\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="MediatR" Version="14.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
		<PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.3.9" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.9" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
		<PackageReference Include="Microsoft.OpenApi" Version="2.4.3" />
		<PackageReference Include="StackExchange.Redis" Version="2.10.1" />
		<PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.1" />
	</ItemGroup>

	<ItemGroup>
		<None Update="logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
